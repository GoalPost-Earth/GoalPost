# GraphQL endpoint. Leave RELATIVE so the client always hits the same
# origin it's served from — works for local dev, Vercel previews, and
# production alike. This is a NEXT_PUBLIC_ var (inlined into the client
# bundle at BUILD time), so do NOT set an absolute http://localhost URL in
# any deployed environment: on an HTTPS deploy the browser blocks it as
# mixed content and every GraphQL fetch fails with "Failed to fetch".
NEXT_PUBLIC_GRAPHQL_URI=/api/graphql

# Neo4j Database Configuration
NEO4J_PASSWORD=your-neo4j-password
NEO4J_URI=neo4j://your-neo4j-host:7687
NEO4J_USERNAME=neo4j
# NEO4J_USER is accepted as an alias for NEO4J_USERNAME (src/lib/neo4j/driver.ts) —
# set one or the other, not both.
NEO4J_USER=neo4j
# CONFIRM: no code in this repo reads NEO4J_ENCRYPTED today (kept here rather
# than silently dropped — a human should decide whether it's genuinely dead
# or the driver should honor it).
NEO4J_ENCRYPTED=false
# Selects a non-default Neo4j database on the same DBMS (src/lib/graphql/apollo.ts).
# Leave unset to use the driver/DBMS default.
NEO4J_DATABASE=neo4j
# Prod-side Neo4j creds, used ONLY by the one-off backfill script
# scripts/backfill-resonance-created-at.ts (reads prod, writes dev). Not needed
# for normal app runtime — omit unless you're running that specific script.
NEO4J_PROD_URI=neo4j://your-prod-neo4j-host:7687
NEO4J_PROD_USERNAME=neo4j
NEO4J_PROD_PASSWORD=your-neo4j-prod-password

# JWT Secret for Authentication.
# Tokens are signed and verified with HS256 (symmetric HMAC), so this MUST
# be a single-line, high-entropy RANDOM STRING — NOT a PEM key/certificate
# (`-----BEGIN ...`). A PEM value breaks HS256 verification and gets mangled
# differently across .env files / Vercel env vars, producing un-verifiable
# tokens (the cause of the 401 request-storm class of bug).
# Generate one with: openssl rand -base64 48
# Use the EXACT SAME value in every environment (local, Vercel Production,
# AND Preview) so tokens issued in one verify in another. Rotating it logs
# all users out once.
JWT_SECRET=your-jwt-secret

# Shared secret for Vercel cron invocations. Vercel automatically sends
# `Authorization: Bearer <CRON_SECRET>` when this env var is set in the
# project. The /api/cron/discover-resonances handler rejects calls whose
# Authorization header doesn't match. Leave unset locally to disable the
# check while developing.
CRON_SECRET=your-cron-secret

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key
# Optional — point at an OpenAI-compatible endpoint other than the default
# api.openai.com (e.g. an Azure/proxy gateway). Leave unset to use the
# provider's normal default.
OPENAI_API_BASE=

# Assistant chat model. Drives the three Assistant Modes (Standard, Aiden,
# Braider) and tool-calling. Prefer a non-reasoning agent-tuned model here —
# reasoning models (e.g. gpt-5.1) think internally and can produce empty
# text responses after tool errors. The embedding model
# (text-embedding-3-small) is configured separately and not affected by this
# setting. If unset, defaults to gpt-5.4.
OPENAI_ASSISTANT_MODEL=gpt-5.4
# Reasoning effort for the assistant model, when it IS a reasoning model.
# See src/lib/llm/factory.ts OPENAI_ASSISTANT_REASONING_EFFORT.
OPENAI_ASSISTANT_REASONING_EFFORT=

# General LLM provider selection (src/lib/llm/factory.ts). Valid: openai | mock
# (mistral/bedrock are stubbed, not yet implemented). LLM_PROVIDER is the
# fallback for all three op-specific vars below — set it alone to cover
# everything, or override per operation.
LLM_PROVIDER=openai
CHAT_PROVIDER=
EMBEDDINGS_PROVIDER=
ANALYSIS_PROVIDER=
# Default OpenAI chat/completions model for non-assistant LLM calls
# (src/modules/agent/react-agent.ts). Distinct from OPENAI_ASSISTANT_MODEL.
OPENAI_MODEL=
# Optional JSON override of per-model $/1k-token pricing used for usage/cost
# metering (src/lib/llm/pricing.ts). Leave unset to use the built-in table.
LLM_PRICING_JSON=

# Additional variables from .env.local
PEPPER=your-pepper
RESEND_API_KEY=your-resend-api-key

# Seed script defaults (scripts/seed-initial-user.js) — the initial demo user
# it creates when none exists. All optional; each falls back to a hardcoded
# demo default (see the script) if unset. DEV-ONLY.
SEED_USER_EMAIL=demo@goalpost.app
SEED_USER_NAME="Demo User"
SEED_USER_FIRST_NAME=
SEED_USER_LAST_NAME=
SEED_USER_PASSWORD=password123

# Prod→dev migration: account whose password Phase 5b resets after a migration
# so the team can always log into the refreshed dev DB. DEV-ONLY (the migration
# refuses to run against prod). Omit both to skip the reset step.
DEV_LOGIN_EMAIL=you@example.com
DEV_LOGIN_PASSWORD=password

# Prod→dev migration Phase 5c2 (GOAL-299): the "Artisans Cooperative" resource is
# also an :Organization living in a shared WeSpace between its creator (owner) and
# a member. These are real personal emails, so they're read from here (gitignored)
# rather than committed in the script. Omit either to skip the step. DEV-ONLY.
ARTISANS_OWNER_EMAIL=owner@example.com
ARTISANS_MEMBER_EMAIL=member@example.com

NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_EMAIL_FROM="Goalpost <info@goalpost.earth>"

# Hide the public sign up flow (invite-only onboarding). When "true", the
# "Create an account" links are hidden on the auth pages and the /auth/signup
# page route is redirected to /auth/login by middleware. NEXT_PUBLIC_ so the
# same value drives both the client UI (SIGNUP_DISABLED constant) and middleware.
# Leave unset/false to keep self-service registration open.
NEXT_PUBLIC_DISABLE_SIGNUP=true

# Document ingestion — blob storage (AWS S3).
# The browser uploads PDFs directly to S3 via presigned PUT URLs minted by
# /api/ingest/document/presign; Gemini fetches via presigned GET URLs during
# extraction. Set to "memory" to disable S3 and use an in-process store for
# local tests instead (src/app/api/cron/process-document-ingestion/route.ts,
# src/app/api/user/avatar/presign/route.ts). Leave unset to use S3.
INGEST_BLOB_BACKEND=
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Optional — leave unset to use the SDK's default provider chain (IAM role,
# ~/.aws/credentials, etc.) instead of explicit credentials.
# If you're using temporary STS credentials, also set AWS_SESSION_TOKEN.
# Put real values in .env.local (gitignored), NEVER in .env.example.

# Document ingestion — multimodal model for PDFs (Gemini).
# Text uploads (.txt/.md) still route through OPENAI_INGEST_EXTRACTION_MODEL.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
GEMINI_INGEST_EXTRACTION_MODEL=gemini-2.5-pro
GEMINI_INGEST_SUMMARY_MODEL=gemini-2.5-pro

# Document ingestion — text-only extractor for .txt/.md.
OPENAI_INGEST_EXTRACTION_MODEL=gpt-5.4
OPENAI_INGEST_SUMMARY_MODEL=gpt-5.4

# Rate limiting (GOAL-249) — Upstash Redis (or Vercel KV, which exposes
# the same env-var contract). Used by src/lib/auth/rate-limit.ts to
# throttle auth endpoints + the addSpaceMember invite-blast surface.
# If unset, the limiter logs a warning and falls back to fail-open for
# read-y unauthenticated endpoints and fail-CLOSED for invite-blast —
# see src/lib/auth/rate-limit.ts POLICY_FAILURE_MODE.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Background jobs (BullMQ) — resonance discovery + pulse/enrichment processing
# (src/lib/jobs/queue-config.ts). Needs a real Redis reachable at host:port
# (distinct from the Upstash/KV pair above, which is REST-based rate limiting).
REDIS_HOST=localhost
REDIS_PORT=6379
# Cron expression for the resonance-discovery job. Defaults to daily at 02:00
# if unset (standard 5-field cron syntax).
RESONANCE_DISCOVERY_CRON="0 2 * * *"

# CORS allow-origin for /api/* routes (next.config.ts, src/app/api/graphql/route.ts).
# Defaults to "*" in development, http://localhost:3000 otherwise if unset.
CORS_ORIGIN=

# Show the internal /dev dashboards (LLM usage, etc.) — gated off unless this
# is exactly "true". Leave unset in any shared/deployed environment.
ENABLE_DEV_DASHBOARDS=false

# Base URL the server uses for its own internal fetches (e.g. logging a
# newly-created pulse to the activity log). Distinct from the client-facing
# NEXT_PUBLIC_BASE_URL above. Defaults to http://localhost:3000 if unset.
NEXTAUTH_URL=http://localhost:3000

# Minimum level the logger emits (src/lib/logger.ts). Leave unset for the
# logger's own default.
LOG_LEVEL=info

# NOTE: GOOGLE_GENERATIVE_AI_API_KEY above is read implicitly by the @ai-sdk/google
# package's default provider — it's not an explicit process.env read anywhere in
# this repo's own code, so don't be surprised a plain `grep process.env` misses it.

# NOTE: VERCEL, VERCEL_ENV, VERCEL_PROJECT_PRODUCTION_URL, NEXT_RUNTIME, and
# AWS_LAMBDA_FUNCTION_NAME are platform-injected at deploy time (Vercel / AWS
# Lambda / Next.js itself) — never set these by hand, they're listed here only
# so their effect on logging (src/lib/logger.ts) and URL resolution
# (src/lib/url/app-base-url.ts, src/app/api/auth/request-reset/route.ts) is
# discoverable from this file.

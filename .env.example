NEXT_PUBLIC_GRAPHQL_URI=http://localhost:3000/api/graphql

# Neo4j Database Configuration
NEO4J_PASSWORD=your-neo4j-password
NEO4J_URI=neo4j://your-neo4j-host:7687
NEO4J_USERNAME=neo4j
NEO4J_ENCRYPTED=false

# JWT Secret for Authentication.
# Tokens are signed and verified with HS256 (symmetric HMAC), so this MUST
# be a single-line, high-entropy RANDOM STRING — NOT a PEM key/certificate
# (`-----BEGIN ...`). A PEM value breaks HS256 verification and gets mangled
# differently across .env files / Vercel env vars, producing un-verifiable
# tokens (the cause of the 401 request-storm class of bug).
# Generate one with: openssl rand -base64 48
# Use the EXACT SAME value in every environment (local, Vercel Production,
# AND Preview) so tokens issued in one verify in another. Rotating it logs
# all users out once.
JWT_SECRET=your-jwt-secret

# Shared secret for Vercel cron invocations. Vercel automatically sends
# `Authorization: Bearer <CRON_SECRET>` when this env var is set in the
# project. The /api/cron/discover-resonances handler rejects calls whose
# Authorization header doesn't match. Leave unset locally to disable the
# check while developing.
CRON_SECRET=your-cron-secret

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# Assistant chat model. Drives the three Assistant Modes (Standard, Aiden,
# Braider) and tool-calling. Prefer a non-reasoning agent-tuned model here —
# reasoning models (e.g. gpt-5.1) think internally and can produce empty
# text responses after tool errors. The embedding model
# (text-embedding-3-small) is configured separately and not affected by this
# setting. If unset, defaults to gpt-5.4.
OPENAI_ASSISTANT_MODEL=gpt-5.4

# Additional variables from .env.local
PEPPER=your-pepper
RESEND_API_KEY=your-resend-api-key

# Prod→dev migration: account whose password Phase 5b resets after a migration
# so the team can always log into the refreshed dev DB. DEV-ONLY (the migration
# refuses to run against prod). Omit both to skip the reset step.
DEV_LOGIN_EMAIL=you@example.com
DEV_LOGIN_PASSWORD=password
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_EMAIL_FROM="Goalpost <info@goalpost.earth>"

# Document ingestion — blob storage (AWS S3).
# The browser uploads PDFs directly to S3 via presigned PUT URLs minted by
# /api/ingest/document/presign; Gemini fetches via presigned GET URLs during
# extraction. Set INGEST_BLOB_BACKEND=memory to disable S3 for local tests.
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Optional — leave unset to use the SDK's default provider chain (IAM role,
# ~/.aws/credentials, etc.) instead of explicit credentials.
# If you're using temporary STS credentials, also set AWS_SESSION_TOKEN.
# Put real values in .env.local (gitignored), NEVER in .env.example.

# Document ingestion — multimodal model for PDFs (Gemini).
# Text uploads (.txt/.md) still route through OPENAI_INGEST_EXTRACTION_MODEL.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
GEMINI_INGEST_EXTRACTION_MODEL=gemini-2.5-pro
GEMINI_INGEST_SUMMARY_MODEL=gemini-2.5-pro

# Document ingestion — text-only extractor for .txt/.md.
OPENAI_INGEST_EXTRACTION_MODEL=gpt-5.4
OPENAI_INGEST_SUMMARY_MODEL=gpt-5.4

# Rate limiting (GOAL-249) — Upstash Redis (or Vercel KV, which exposes
# the same env-var contract). Used by src/lib/auth/rate-limit.ts to
# throttle auth endpoints + the addSpaceMember invite-blast surface.
# If unset, the limiter logs a warning and falls back to fail-open for
# read-y unauthenticated endpoints and fail-CLOSED for invite-blast —
# see src/lib/auth/rate-limit.ts POLICY_FAILURE_MODE.
KV_REST_API_URL=
KV_REST_API_TOKEN=
